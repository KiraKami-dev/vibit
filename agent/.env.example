# Local runs only: copy to agent/.env (gitignored, never packaged) and fill in. Variables already set in the
# environment win. Test and scored runs ignore this file: set keys there as team secrets instead.

# Model backend: qwen (the hosted model, default) or anthropic (the team's own key).
LLM_BACKEND=qwen

# Model id; empty means the backend's default (qwen3.8-flash-next, or claude-haiku-5-5 for anthropic).
LLM_MODEL=

# Anthropic API key, needed only for LLM_BACKEND=anthropic. Placeholder: put the real key into .env only.
ANTHROPIC_API_KEY=sk-ant-placeholder

# Anthropic effort for thinking-on calls: low, medium (default), high, xhigh, max.
LLM_EFFORT=

# Where Anthropic calls go; empty means the run's proxy ($LLM_PROXY_URL/anthropic), else the Anthropic API.
ANTHROPIC_BASE_URL=
