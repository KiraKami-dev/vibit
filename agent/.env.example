# Local runs only: copy to agent/.env (gitignored, never packaged) and fill in. Variables already set in the
# environment win. Test and scored runs ignore this file: set keys there as team secrets instead.

# Model backend: qwen (the hosted model, default), anthropic or openrouter (the team's own keys).
LLM_BACKEND=qwen

# Model id; empty means the backend's default (qwen3.8-flash-next, claude-haiku-5-5 for anthropic,
# z-ai/glm-5.3-flash for openrouter).
LLM_MODEL=

# Anthropic API key, needed only for LLM_BACKEND=anthropic. Placeholder: put the real key into .env only.
ANTHROPIC_API_KEY=sk-ant-placeholder

# OpenRouter API key, needed only for LLM_BACKEND=openrouter. Placeholder: put the real key into .env only.
OPENROUTER_API_KEY=sk-or-placeholder

# OpenRouter provider to pin (no fallbacks); empty means fireworks, "any" lets OpenRouter choose.
LLM_PROVIDER=

# Effort for thinking-on calls: low, medium (default), high (Anthropic also xhigh, max).
LLM_EFFORT=

# Effort for thinking-off calls on models that cannot stop thinking (GLM 5.3 Flash, Opus 5.5); default low.
LLM_EFFORT_OFF=

# Where Anthropic calls go; empty means the run's proxy ($LLM_PROXY_URL/anthropic), else the Anthropic API.
ANTHROPIC_BASE_URL=

# Where OpenRouter calls go; empty means the run's proxy ($LLM_PROXY_URL/openrouter/v1), else OpenRouter itself.
OPENROUTER_BASE_URL=
